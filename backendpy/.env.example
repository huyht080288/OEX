# OEX Python backend — copy to .env and adjust. Never commit .env.
# Same DATABASE_URL format as the Node backend (the ?schema= part is optional).
DATABASE_URL="postgresql://oex:oex@localhost:5005/oex?schema=public"
# Dev-only placeholder: use a random string of 32+ characters.
JWT_SECRET="change-me-to-a-random-string-of-32-chars-or-more"
JWT_EXPIRES_IN="1h"
HOST="127.0.0.1"
PORT=5002
CORS_ORIGIN="http://localhost:5001"
# development (auto-reload) | test | production
APP_ENV="development"
# Set to "false" to disable Swagger UI (/api/docs)
SWAGGER_ENABLED="true"
